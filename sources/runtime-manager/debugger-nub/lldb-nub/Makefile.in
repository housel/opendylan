srcdir		= @srcdir@
top_srcdir	= @top_srcdir@
top_builddir	= @top_builddir@

subdir		= sources/runtime-manager/debugger-nub/lldb-nub

VPATH		= $(srcdir)

BIN_DEST        = $(OPEN_DYLAN_USER_INSTALL)/bin

CC		= @CC@
CXX		= @CXX@

INSTALL         = @INSTALL@

IDL		= $(top_srcdir)/sources/runtime-manager/debugger-nub/remote-nub.idl

CFLAGS          = @CFLAGS@
CXXFLAGS        = @CXXFLAGS@
LDFLAGS         = @LDFLAGS@

OMNIORB_CFLAGS	= @OMNIORB_CFLAGS@ -std=c++17 -I.
OMNIORB_LIBS	= @OMNIORB_LIBS@
OMNIIDL         = @OMNIIDL@

LLDB_CPPFLAGS   = @LLDB_CPPFLAGS@ @DEFS@
LLDB_CXXFLAGS   = @LLDB_CXXFLAGS@
LLDB_LDFLAGS    = @LLDB_LDFLAGS@
LLDB_LIBS       = @LLDB_LIBS@

LLDB_OBJS       = NubProcess.o \
                  NubLLDBContext.o \
                  NubExecutorProcessControl.o \
                  NubProcessMemoryManager.o \
                  ddapp.o

OBJS            = $(LLDB_OBJS) \
		  nub-server-impl.o \
		  remote-nub-impl.o \
		  remote-nub-skels.o \
		  main.o

all:	dylan-debugger-nub

dylan-debugger-nub: $(OBJS)
	$(CXX) -o dylan-debugger-nub $(CXXFLAGS) $(OMNIORB_CFLAGS) \
	    $(LDFLAGS) $(LLDB_LDFLAGS) \
	    $(OBJS) $(OMNIORB_LIBS) $(LLDB_LIBS)

remote-nub.h remote-nub-skels.cpp: $(IDL)
	$(OMNIIDL) -bcxx -Wbs=-skels.cpp -Wbh=.h $(IDL)

NubProcess.o: NubProcess.cpp
	$(CXX) -MMD -c $(CXXFLAGS) $(LLDB_CXXFLAGS) $(LLDB_CPPFLAGS) \
            -I. -o $@ $(srcdir)/NubProcess.cpp
NubLLDBContext.o: NubLLDBContext.cpp
	$(CXX) -MMD -c $(CXXFLAGS) $(LLDB_CXXFLAGS) $(LLDB_CPPFLAGS) \
            -I. -o $@ $(srcdir)/NubLLDBContext.cpp

NubExecutorProcessControl.o: NubExecutorProcessControl.cpp
	$(CXX) -MMD -c $(CXXFLAGS) $(LLDB_CXXFLAGS) $(LLDB_CPPFLAGS) \
            -I. -o $@ $(srcdir)/NubExecutorProcessControl.cpp
NubProcessMemoryManager.o: NubProcessMemoryManager.cpp
	$(CXX) -MMD -c $(CXXFLAGS) $(LLDB_CXXFLAGS) $(LLDB_CPPFLAGS) \
            -I. -o $@ $(srcdir)/NubProcessMemoryManager.cpp
ddapp.o: ddapp.cpp
	$(CXX) -MMD -c $(CXXFLAGS) $(LLDB_CXXFLAGS) $(LLDB_CPPFLAGS) \
            -I. -o $@ $(srcdir)/ddapp.cpp

nub-server-impl.o: nub-server-impl.cpp remote-nub.h
	$(CXX) -MMD -c $(CXXFLAGS) $(OMNIORB_CFLAGS) \
	    -o $@ $(srcdir)/nub-server-impl.cpp
remote-nub-impl.o: remote-nub-impl.cpp remote-nub.h
	$(CXX) -MMD -c $(CXXFLAGS) $(OMNIORB_CFLAGS) \
	    -o $@ $(srcdir)/remote-nub-impl.cpp
remote-nub-skels.o: remote-nub-skels.cpp remote-nub.h
	$(CXX) -MMD -c $(CXXFLAGS) $(OMNIORB_CFLAGS) \
	    -o $@ remote-nub-skels.cpp
main.o: main.cpp remote-nub.h
	$(CXX) -MMD -c $(CXXFLAGS) $(OMNIORB_CFLAGS) \
	    -o $@ $(srcdir)/main.cpp

install: dylan-debugger-nub
	$(INSTALL) -d $(BIN_DEST)
	$(INSTALL) -s dylan-debugger-nub $(BIN_DEST)

clean:
	rm -f dylan-debugger-nub $(OBJS) $(OBJS:%.o=%.d) remote-nub.h remote-nub-skels.cpp

Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	cd $(top_builddir) && ./config.status $(subdir)/Makefile

-include $(OBJS:%.o=%.d)

